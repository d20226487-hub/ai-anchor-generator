# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev.log
tsc-output.txt
*.log

# env files (can opt-in for committing if needed)
.env*

# local SQLite database (contains plaintext API keys + job data)
/data.db
/data.db-*
/data/*.db
/data/*.db-*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
